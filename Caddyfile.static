{
	admin off
	auto_https off
}

:80 {
	root * /srv
	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# 2026-10-24: NetworkLogger and RTL-Migrate became one "Development tools" page; FluxGate left the site
	@oldtools path /projects/networklogger /projects/networklogger/ /projects/rtl-migrate /projects/rtl-migrate/
	redir @oldtools /projects/developer-tools/ permanent
	@aidev path /projects/aidev /projects/aidev/
	redir @aidev /projects/aidevkit/ permanent
	@fluxgate path /projects/fluxgate /projects/fluxgate/
	redir @fluxgate /#projects permanent

	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
